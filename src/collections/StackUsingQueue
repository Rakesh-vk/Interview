import java.util.*;

public class Main {

    public static void main(String[] args) {
        int[] arr={1,2,5,3};
        StackUsingQueue(arr);
        
    }
    public static void StackUsingQueue(int[] arr){
        Queue<Integer> stack = new Queue<>();
        
        for(int i=0;i<arr.length;i++){
            stack.push(arr[i]);
        }
        while(!stack.isEmpty()){
            System.out.println(stack.peek());
            stack.pop();
        }
        
        
    }
    
}